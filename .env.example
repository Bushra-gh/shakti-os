# ShaktiOS environment template. Copy to .env and fill in real values.
# NEVER commit .env. NEVER put server secrets in NEXT_PUBLIC_* variables.
#
# Architecture:
#   Supabase (PostgreSQL + Auth + Storage)  <-- sole runtime database
#   FastAPI ShaktiOS Core                   <-- connects via DATABASE_URL
#   Next.js dashboard / Expo citizen app    <-- talk to FastAPI, never to DB directly

# ==========================================
# PUBLIC / CLIENT-SAFE (may be exposed to browsers / Expo)
# ==========================================

# Supabase project URL (public; also used by Expo for Supabase Auth).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Supabase publishable (anon) key — safe for client use. NOT the service-role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# FastAPI base URL used by the Next.js dashboard.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ==========================================
# SERVER ONLY (never expose to clients)
# ==========================================

# Supabase PostgreSQL pooler connection string (Transaction mode, port 6543).
# Must include sslmode=require. Get it from Supabase Dashboard > Connect.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Must match NEXT_PUBLIC_SUPABASE_URL; used for JWT JWKS verification.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Publishable key, server-side copy (used only where a Supabase client is needed).
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Used by `supabase link --project-ref`.
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
# Expected JWT audience. Default is "authenticated".
SUPABASE_JWT_AUDIENCE=authenticated
# Comma-separated operator Supabase user UUIDs/emails. Required for dashboard API access.
OPERATOR_USER_IDS=
OPERATOR_EMAILS=operator@example.com

# Optional connection-pool tuning for the Supabase pooler.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Optional CORS allow-list (comma-separated). Defaults to http://localhost:3000.
CORS_ORIGINS=http://localhost:3000

# Optional voice-to-report drafts (FastAPI only; leave blank to disable).
# Obtain your own key from Sarvam. Never put it in EXPO_PUBLIC_* or NEXT_PUBLIC_*.
# Explicit user consent sends audio/transcript to Sarvam; a draft is never submitted automatically.
# Setup, privacy/limits and mocked checks: docs/VOICE_REPORTING.md
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_CHAT_MODEL=sarvam-105b

# ==========================================
# EXISTING SHAKTIOS SERVICES (unchanged)
# ==========================================

API_PORT=8000
INCIDENT_CORRELATION_WINDOW_SECONDS=300
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
# Base URL used by the crowd simulator, civic-shield bridge, and seed script.
SHAKTIOS_API_URL=http://localhost:8000
# LLM provider for Civic-Shield sentiment analysis (optional; falls back to neutral).
GROQ_API_KEY=
